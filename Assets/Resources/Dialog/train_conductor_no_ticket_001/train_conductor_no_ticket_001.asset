    transitions: []
  - id: line_6_npc2_final_service_2
    roleId: NPC_5
    text: "\u041B\u0430\u0434\u043D\u043E, \u044F \u043F\u043E\u0439\u0434\u0443
      \u0432 \u043A\u0430\u0441\u0441\u0443, \u0440\u0430\u0437 \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443
