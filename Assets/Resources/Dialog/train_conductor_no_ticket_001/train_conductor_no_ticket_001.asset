  - id: line_8_npc2_final_informative_1
    roleId: NPC_5
    text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0436\u0434\u0443 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430."
