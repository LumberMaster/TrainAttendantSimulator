  m_Script: {fileID: 11500000, guid: 8003a57573558cb4d8505d7a398c2a9e, type: 3}
  m_Name: train_conductor_no_ticket_001
  m_EditorClassIdentifier: Assembly-CSharp::Game.DialogAsset
  id: train_conductor_no_ticket_001
  description: "\u0414\u0438\u0430\u043B\u043E\u0433 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
    (Player) \u0438 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 NPC_2,
    \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u043E\u0435\u0437\u0434\u043D\u043E\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
    (\u0431\u0438\u043B\u0435\u0442). \u041E\u0442\u0432\u0435\u0442\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
    \u0432\u044B\u043D\u0435\u0441\u0435\u043D\u044B \u0432 transitions. \u0412\u0441\u0435
    \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0435 \u0440\u0435\u043F\u043B\u0438\u043A\u0438
    \u0438\u043C\u0435\u044E\u0442 isEnd: true \u0438 \u043F\u0443\u0441\u0442\u044B\u0435
    transitions. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B
    \u0440\u043E\u043B\u0435\u0432\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438
    \u0420\u0416\u0414."
  lines:
  - id: line_1_npc2_no_ticket
    roleId: NPC_5
    text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435.
      \u042F \u043F\u043E\u0434\u043E\u0448\u0435\u043B \u043A \u043F\u043E\u0435\u0437\u0434\u0443,
      \u043D\u043E \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0435\u0437\u0434\u043D\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430.
      \u042F \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0439
      \u0431\u0438\u043B\u0435\u0442, \u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0435\u0433\u043E \u043D\u0430\u0439\u0442\u0438 \u0432 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435.
      \u041A\u0430\u043A \u043C\u043D\u0435 \u0431\u044B\u0442\u044C?"
    audio: {fileID: 0}
    isEnd: 0
    useTimer: 0
    timerDuration: 0
    transitions:
    - choiceText: "\u042F \u0412\u0430\u0441 \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
        \u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C
        \u0412\u0430\u0448\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
        \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0431\u0435\u0437 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0435\u0437\u0434\u043D\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
        \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F.
        \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C\u0441\u044F."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_2_npc2_service
      parameters:
      - name: LoalityPassager
        value: 8
      - name: SecurityRating
        value: 5
    - choiceText: "\u0418\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E \u0412\u0430\u0441
        \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043F\u0440\u043E\u0435\u0437\u0434
        \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
        \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u0431\u0438\u043B\u0435\u0442\u0430.
        \u042F \u0443\u0442\u043E\u0447\u043D\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
        \u0438 \u0432\u0435\u0440\u043D\u0443\u0441\u044C \u043A \u0412\u0430\u043C."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_3_npc2_informative
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 5
    - choiceText: "\u042F \u0441\u043E\u0436\u0430\u043B\u0435\u044E, \u0447\u0442\u043E
        \u044D\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u043E
        \u0412\u0430\u043C \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442.
        \u0414\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u044D\u0442\u043E\u0433\u043E
        \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u043C\u043D\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
        \u0432\u0440\u0435\u043C\u044F."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_4_npc2_strict
      parameters:
      - name: LoalityPassager
        value: -5
      - name: SecurityRating
        value: 7
  - id: line_2_npc2_service
    roleId: NPC_5
    text: "\u042F \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u0447\u0435\u0440\u0435\u0437
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u043D\u043E
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0440\u0430\u0437\u0440\u044F\u0434\u0438\u043B\u0441\u044F.
      \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043D\u0435\u043B\u044C\u0437\u044F
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u043E \u0444\u0430\u043C\u0438\u043B\u0438\u0438?"
    audio: {fileID: 0}
    isEnd: 0
    useTimer: 0
    timerDuration: 0
    transitions:
    - choiceText: "\u042F \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0443 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
        \u043F\u043E\u0435\u0437\u0434\u0430, \u043E\u043D \u0441\u043C\u043E\u0436\u0435\u0442
        \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
        \u043F\u043E \u0431\u0430\u0437\u0435."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_5_npc2_final_service_1
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 3
    - choiceText: "\u041E\u0431\u0440\u0430\u0449\u0430\u044E \u0412\u0430\u0448\u0435
        \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0447\u0442\u043E \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435
        \u0431\u0438\u043B\u0435\u0442\u043E\u0432 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
        \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0437 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
        \u043A\u0430\u043D\u0430\u043B\u044B. \u042F \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044E
        \u0412\u0430\u0441 \u0432 \u043A\u0430\u0441\u0441\u0443."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_6_npc2_final_service_2
      parameters:
      - name: LoalityPassager
        value: 7
      - name: SecurityRating
        value: 3
    - choiceText: "\u042F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E
        \u0412\u0430\u0441 \u0437\u0430 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
        \u043D\u043E \u0431\u0435\u0437 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
        \u044F \u043E\u0431\u044F\u0437\u0430\u043D \u0432\u044B\u0441\u0430\u0434\u0438\u0442\u044C
        \u0432\u0430\u0441 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
        \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_7_npc2_final_service_3
      parameters:
      - name: LoalityPassager
        value: -3
      - name: SecurityRating
        value: 6
  - id: line_3_npc2_informative
    roleId: NPC_5
    text: "\u042F \u043E\u0447\u0435\u043D\u044C \u0441\u043F\u0435\u0448\u0443.
      \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u0438\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E
      \u043C\u0435\u043D\u044F \u0432\u044B\u0441\u0430\u0434\u044F\u0442?"
    audio: {fileID: 0}
    isEnd: 0
    useTimer: 0
    timerDuration: 0
    transitions:
    - choiceText: "\u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C
        \u0412\u0430\u0448\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
        \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u044F \u043E\u0431\u044F\u0437\u0430\u043D
        \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C.
        \u042F \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0443 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
        \u043F\u043E\u0435\u0437\u0434\u0430."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_8_npc2_final_informative_1
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 4
    - choiceText: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0412\u0430\u0441
        \u0437\u0430 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435. \u042F \u0443\u0442\u043E\u0447\u043D\u044E
        \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0432 \u0431\u0430\u0437\u0435
        \u0434\u0430\u043D\u043D\u044B\u0445."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_9_npc2_final_informative_2
      parameters:
      - name: LoalityPassager
        value: 6
      - name: SecurityRating
        value: 3
    - choiceText: "\u041F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E
        \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u0430\u044F.
        \u041D\u043E \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
        \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043F\u043E\u0435\u0437\u0434."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_10_npc2_final_informative_3
      parameters:
      - name: LoalityPassager
        value: -5
      - name: SecurityRating
        value: 6
  - id: line_4_npc2_strict
    roleId: NPC_5
    text: "\u0412\u044B \u043D\u0435 \u0438\u043C\u0435\u0435\u0442\u0435 \u043F\u0440\u0430\u0432\u0430
      \u043C\u0435\u043D\u044F \u0432\u044B\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C!
      \u042F \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0434\u0435\u043D\u044C\u0433\u0438!"
    audio: {fileID: 0}
    isEnd: 0
    useTimer: 0
    timerDuration: 0
    transitions:
    - choiceText: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0437\u0430
        \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435. \u042F \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0443
        \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430 \u043F\u043E\u0435\u0437\u0434\u0430
        \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0432\u043E\u043F\u0440\u043E\u0441\u0430."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_11_npc2_final_strict_1
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 4
    - choiceText: "\u042F \u0412\u0430\u0441 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
        \u043D\u043E \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F
        \u044D\u0442\u043E\u0433\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u0430
        \u043C\u043D\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
        \u0432\u0440\u0435\u043C\u044F."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_12_npc2_final_strict_2
      parameters:
      - name: LoalityPassager
        value: -2
      - name: SecurityRating
        value: 6
    - choiceText: "\u042F \u0441\u043E\u0436\u0430\u043B\u0435\u044E, \u0447\u0442\u043E
        \u044D\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u043E
        \u0412\u0430\u043C \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442,
        \u043D\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0439\u0442\u0438
        \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_13_npc2_final_strict_3
      parameters:
      - name: LoalityPassager
        value: -8
      - name: SecurityRating
        value: 7
  - id: line_5_npc2_final_service_1
    roleId: NPC_5
    text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0437\u043E\u0432\u0438\u0442\u0435
      \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430 \u043F\u043E\u0435\u0437\u0434\u0430.
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D \u0440\u0435\u0448\u0438\u0442
      \u0432\u043E\u043F\u0440\u043E\u0441."
