    isEnd: 1
    useTimer: 0
    timerDuration: 0
    transitions: []
  - id: line_11_npc2_final_strict_1
    roleId: NPC_5
    text: "\u0417\u043E\u0432\u0438\u0442\u0435 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430,
      \u044F \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0439\u0434\u0443."
    audio: {fileID: 0}
    isEnd: 1
    useTimer: 0
    timerDuration: 0
    transitions: []
  - id: line_12_npc2_final_strict_2
    roleId: NPC_5
    text: "\u041B\u0430\u0434\u043D\u043E, \u044F \u043F\u043E\u0434\u043E\u0436\u0434\u0443.
      \u041D\u043E \u044D\u0442\u043E \u0432\u043E\u0437\u043C\u0443\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E."
