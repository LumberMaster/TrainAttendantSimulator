  m_Script: {fileID: 11500000, guid: 8003a57573558cb4d8505d7a398c2a9e, type: 3}
  m_Name: train_conductor_broken_socket_005
  m_EditorClassIdentifier: Assembly-CSharp::Game.DialogAsset
  id: train_conductor_broken_socket_005
  description: "\u0414\u0438\u0430\u043B\u043E\u0433 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
    (Player) \u0438 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 NPC_2,
    \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0440\u043E\u0437\u0435\u0442\u043A\u0430/\u043C\u0443\u043B\u044C\u0442\u0438\u043C\u0435\u0434\u0438\u0430/\u043A\u043D\u043E\u043F\u043A\u0430
    \u0432\u044B\u0437\u043E\u0432\u0430. \u041E\u0442\u0432\u0435\u0442\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
    \u0432\u044B\u043D\u0435\u0441\u0435\u043D\u044B \u0432 transitions. \u0412\u0441\u0435
    \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0435 \u0440\u0435\u043F\u043B\u0438\u043A\u0438
    \u0438\u043C\u0435\u044E\u0442 isEnd: true \u0438 \u043F\u0443\u0441\u0442\u044B\u0435
    transitions. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B
    \u0440\u043E\u043B\u0435\u0432\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438
    \u0420\u0416\u0414."
  lines:
  - id: line_1_npc2_broken_device
    roleId: NPC_3
    text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435.
      \u0423 \u043C\u0435\u043D\u044F \u0432 \u043A\u0443\u043F\u0435 \u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0440\u043E\u0437\u0435\u0442\u043A\u0430.
      \u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u044C
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u0427\u0442\u043E \u043C\u043D\u0435
      \u0434\u0435\u043B\u0430\u0442\u044C?"
    audio: {fileID: 8300000, guid: c9fc4dd17fe15f04a997b226fd791b3c, type: 3}
    isEnd: 0
    useTimer: 1
    timerDuration: 10
    transitions:
    - choiceText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E
        \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0438. \u0421\u0435\u0439\u0447\u0430\u0441
        \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0435.
        \u041F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F
        \u0437\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
        \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0430, \u043C\u043E\u0433\u0443
        \u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0412\u0430\u043C
        \u043F\u0435\u0440\u0435\u0441\u0435\u0441\u0442\u044C?"
      speakerRoleId: Player
      choiceAudio: {fileID: 8300000, guid: 89c6ff7b5fe7a254fa0f9fcab2640453, type: 3}
      targetLineId: line_2_npc2_accepts_move
      parameters:
      - name: LoalityPassager
        value: 8
      - name: SecurityRating
        value: 5
    - choiceText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E
        \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0438. \u0421\u0435\u0439\u0447\u0430\u0441
        \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435.
        \u042F \u043F\u0440\u043E\u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E
        \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430 \u043F\u043E\u0435\u0437\u0434\u0430
        \u0438 \u0431\u043E\u0440\u0442\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430."
      speakerRoleId: Player
      choiceAudio: {fileID: 8300000, guid: 2abd04053a419b64fbec88399a3b8393, type: 3}
      targetLineId: line_3_npc2_technician
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 5
    - choiceText: "\u041F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F
        \u0437\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
        \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0430. \u041C\u043E\u0433\u0443
        \u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0412\u0430\u043C
        \u043F\u0435\u0440\u0435\u0441\u0435\u0441\u0442\u044C \u0438\u043B\u0438
        \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u043E\u043C/\u0440\u043E\u0437\u0435\u0442\u043A\u043E\u0439
        \u0432 \u0432\u0430\u0433\u043E\u043D\u0435?"
      speakerRoleId: Player
      choiceAudio: {fileID: 8300000, guid: 8223db65c6984374cb51357e6a1d9b9f, type: 3}
      targetLineId: line_4_npc2_alternative
      parameters:
      - name: LoalityPassager
        value: 7
      - name: SecurityRating
        value: 3
  - id: line_2_npc2_accepts_move
    roleId: NPC_3
    text: "\u0414\u0430, \u0441\u043F\u0430\u0441\u0438\u0431\u043E, \u044F \u0431\u044B
      \u0445\u043E\u0442\u0435\u043B \u043F\u0435\u0440\u0435\u0441\u0435\u0441\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430."
    audio: {fileID: 8300000, guid: 07ad645437bcaf74db97093ce7f1c970, type: 3}
    isEnd: 0
    useTimer: 1
    timerDuration: 10
    transitions:
    - choiceText: "\u042F \u0443\u0442\u043E\u0447\u043D\u044E \u0438 \u0432\u0435\u0440\u043D\u0443\u0441\u044C
        \u043A \u0412\u0430\u043C. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E
        \u0437\u0430 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_5_npc2_final_move_1
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 3
    - choiceText: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
        \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u043C\u0435\u0441\u0442
        \u043D\u0435\u0442, \u043D\u043E \u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0443
        \u0412\u0430\u043C \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0443."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_6_npc2_final_move_2
      parameters:
      - name: LoalityPassager
        value: -2
      - name: SecurityRating
        value: 4
  - id: line_3_npc2_technician
    roleId: NPC_3
    text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0432\u044B\u0437\u044B\u0432\u0430\u0439\u0442\u0435
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0430. \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u044D\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u043E."
    audio: {fileID: 8300000, guid: 7791489495f843e4880d0f094ff130e4, type: 3}
    isEnd: 0
    useTimer: 1
    timerDuration: 10
    transitions:
    - choiceText: "\u042F \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0443 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
        \u043F\u043E\u0435\u0437\u0434\u0430 \u0438 \u0431\u043E\u0440\u0442\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430.
        \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0412\u0430\u0441
        \u0437\u0430 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_7_npc2_final_tech_1
      parameters:
      - name: LoalityPassager
        value: 4
      - name: SecurityRating
        value: 5
    - choiceText: "\u0414\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F
        \u044D\u0442\u043E\u0433\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u0430
        \u043C\u043D\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
        \u0432\u0440\u0435\u043C\u044F."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_8_npc2_final_tech_2
      parameters:
      - name: LoalityPassager
        value: 2
      - name: SecurityRating
        value: 4
  - id: line_4_npc2_alternative
    roleId: NPC_3
    text: "\u0414\u0440\u0443\u0433\u043E\u0439 \u043F\u043B\u0430\u043D\u0448\u0435\u0442?
      \u042F \u0431\u044B \u043B\u0443\u0447\u0448\u0435 \u043F\u0435\u0440\u0435\u0441\u0435\u043B.
      \u0418\u043B\u0438 \u043C\u043E\u0436\u043D\u043E \u043A\u0430\u043A-\u0442\u043E
      \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0430?"
    audio: {fileID: 8300000, guid: 0a391bb7ef847bc46ae10c272ed467a2, type: 3}
    isEnd: 0
    useTimer: 1
    timerDuration: 10
    transitions:
    - choiceText: "\u042F \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0443 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
        \u043F\u043E\u0435\u0437\u0434\u0430 \u0434\u043B\u044F \u0443\u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
        \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. \u041E\u043D \u0441\u043C\u043E\u0436\u0435\u0442
        \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442
        \u0438\u043B\u0438 \u0431\u043E\u043D\u0443\u0441\u043D\u044B\u0435 \u0431\u0430\u043B\u043B\u044B."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_9_npc2_final_alt_1
      parameters:
      - name: LoalityPassager
        value: 6
      - name: SecurityRating
        value: 5
    - choiceText: "\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u0412\u0430\u0448\u0435
        \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E.
        \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0443
        \u0412\u0430\u043C \u043F\u0435\u0440\u0435\u0441\u0435\u0441\u0442\u044C
        \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u0430\u0433\u043E\u043D."
      speakerRoleId: Player
      choiceAudio: {fileID: 0}
      targetLineId: line_10_npc2_final_alt_2
      parameters:
      - name: LoalityPassager
        value: 5
      - name: SecurityRating
        value: 4
  - id: line_5_npc2_final_move_1
    roleId: NPC_3
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0431\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C."
    audio: {fileID: 8300000, guid: 489d4834672a8fd44844371671a670d8, type: 3}
    isEnd: 1
    useTimer: 1
    timerDuration: 10
    transitions: []
  - id: line_6_npc2_final_move_2
    roleId: NPC_3
    text: "\u041B\u0430\u0434\u043D\u043E, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0443."
    audio: {fileID: 8300000, guid: ff82029bac973da45941903b04ac5d69, type: 3}
    isEnd: 1
    useTimer: 1
    timerDuration: 10
    transitions: []
  - id: line_7_npc2_final_tech_1
    roleId: NPC_3
    text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0436\u0434\u0443."
    audio: {fileID: 8300000, guid: a27c16cf1b216df40abe1d087bdbe5aa, type: 3}
    isEnd: 1
    useTimer: 1
    timerDuration: 10
    transitions: []
  - id: line_8_npc2_final_tech_2
    roleId: NPC_3
    text: "\u041B\u0430\u0434\u043D\u043E, \u043F\u043E\u0434\u043E\u0436\u0434\u0443."
    audio: {fileID: 8300000, guid: 5d1de218b51c01445a0293dd937c2fd4, type: 3}
    isEnd: 1
    useTimer: 1
    timerDuration: 10
    transitions: []
  - id: line_9_npc2_final_alt_1
    roleId: NPC_3
    text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0437\u043E\u0432\u0438\u0442\u0435
      \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430. \u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    audio: {fileID: 8300000, guid: 8aa94eec9be365141b8e9e6653930f71, type: 3}
